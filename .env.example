# PostgreSQL — na primeira execução o sistema pede em /setup
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=automacao_omie
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-minimum

# Superadmin criado automaticamente no primeiro setup
APP_SUPERADMIN_USERNAME=superadmin
APP_SUPERADMIN_PASSWORD=ancora
APP_SUPERADMIN_NAME=Super Admin

# WAHA (WhatsApp)
WAHA_URL=http://127.0.0.1:3000
WAHA_API_KEY=
WAHA_SESSION=default

# Omie — múltiplos aplicativos (IDs separados por vírgula)
OMIE_APPS=EMPRESA_A,EMPRESA_B

# Empresa A
OMIE_EMPRESA_A_NAME=Empresa A Ltda
OMIE_EMPRESA_A_APP_KEY=sua_app_key
OMIE_EMPRESA_A_APP_SECRET=seu_app_secret
# WhatsApp fallback por empresa (opcional)
OMIE_EMPRESA_A_NOTIFY_PHONE=

# Modo teste inicial — também configurável em /settings
TEST_NOTIFY_PHONE=

# Empresa B
OMIE_EMPRESA_B_NAME=Empresa B Ltda
OMIE_EMPRESA_B_APP_KEY=sua_app_key
OMIE_EMPRESA_B_APP_SECRET=seu_app_secret
OMIE_EMPRESA_B_NOTIFY_PHONE=
